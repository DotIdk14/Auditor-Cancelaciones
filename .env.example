# Frontend
# Required at browser runtime because the heavy API is hosted separately.
VITE_HEAVY_API_BASE="https://example.invalid/auditor-api"
VITE_INSFORGE_URL="https://example.insforge.app"
VITE_INSFORGE_ANON_KEY="example-anon-key"

# Backend/API
PORT="3001"
APP_URL="http://localhost:3001"

# Worker
DATABASE_URL="postgresql://user:password@example.invalid:5432/auditor"
AUDIT_WORKER_POLL_MS="5000"
AUDIT_WORKER_CONCURRENCY="2"
AUDIT_EVIDENCE_CONCURRENCY="2"
AUDIT_WORKER_HEARTBEAT_MS="15000"
AUDIT_JOB_STALE_MS="300000"
AUDIT_JOB_MAX_ATTEMPTS="5"
ASSEMBLYAI_TIMEOUT_MS="300000"
OPENROUTER_TIMEOUT_MS="300000"

# Database / InsForge
INSFORGE_URL="https://example.insforge.app"
INSFORGE_ANON_KEY="example-anon-key"
INSFORGE_API_KEY="example-server-api-key"
TEST_DATABASE_URL="postgresql://auditor_test:local_only@127.0.0.1:5432/auditor_test" # Optional local PostgreSQL test harness only; never point this at production.

# AI
# OPENROUTER_API_KEY: Required for LLM extraction through OpenRouter.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

AI_EXTRACTION_MODEL="openai/gpt-5-nano"
AI_VISION_MODEL="qwen/qwen3-vl-8b-instruct"
AI_FALLBACK_MODEL="google/gemini-2.5-flash-lite"
AI_EXTRACTION_CONCURRENCY="3"

# ASSEMBLYAI_API_KEY: Required for audio transcription.
# Used only by the local/server API, not directly by the browser.
ASSEMBLYAI_API_KEY="MY_ASSEMBLYAI_API_KEY"


# Storage
# The bucket name is currently defined in src/lib/insforge/client.ts.

# Feature Flags
MC_RBAC_ENABLED="false"
MC_POLICY_WORKFLOW_ENABLED="false"
MC_AUTH_PROVIDER="pending"
