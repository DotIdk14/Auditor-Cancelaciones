# OPENROUTER_API_KEY: Required for LLM extraction through OpenRouter.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

AI_EXTRACTION_MODEL="openai/gpt-5-nano"
AI_VISION_MODEL="qwen/qwen3-vl-8b-instruct"
AI_FALLBACK_MODEL="google/gemini-2.5-flash-lite"
AI_EXTRACTION_CONCURRENCY="3"

# ASSEMBLYAI_API_KEY: Required for audio transcription.
# Used only by the local/server API, not directly by the browser.
ASSEMBLYAI_API_KEY="MY_ASSEMBLYAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
